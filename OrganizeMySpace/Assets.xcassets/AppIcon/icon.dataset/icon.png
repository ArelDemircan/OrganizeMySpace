<svg width="1024" height="1024" viewBox="0 0 1024 1024" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Arka plan ana degradesi -->
    <linearGradient id="bgGradient" x1="512" y1="0" x2="512" y2="1024" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#8E6FF7"/>
      <stop offset="100%" stop-color="#6442DB"/>
    </linearGradient>

    <!-- macOS İkon Dış Gölgesi -->
    <filter id="macShadow" x="64" y="64" width="896" height="896" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="24" stdDeviation="32" flood-color="#1E1346" flood-opacity="0.35"/>
    </filter>

    <!-- Klasör / Kart Yüzey Gradyanı -->
    <linearGradient id="folderGradient" x1="512" y1="260" x2="512" y2="760" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F5F3FF"/>
    </linearGradient>

    <!-- Kart Vurgu Gölgesi -->
    <filter id="cardShadow" x="200" y="240" width="624" height="540" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#3C218B" flood-opacity="0.22"/>
    </filter>
  </defs>

  <!-- 1. macOS Squircle Arka Planı (824x824 ortalanmış) -->
  <g filter="url(#macShadow)">
    <rect x="100" y="100" width="824" height="824" rx="185" fill="url(#bgGradient)"/>
    <rect x="100.5" y="100.5" width="823" height="823" rx="184.5" stroke="white" stroke-opacity="0.2" stroke-width="1.5"/>
  </g>

  <!-- 2. Arka Plan İnce Dekoratif Parçacıklar -->
  <circle cx="280" cy="270" r="18" fill="#F5F3FF" fill-opacity="0.4"/>
  <circle cx="760" cy="310" r="14" fill="#F5F3FF" fill-opacity="0.3"/>
  <circle cx="740" cy="740" r="22" fill="#F5F3FF" fill-opacity="0.35"/>

  <!-- 3. Ana Beyaz Düzenleme Kartı -->
  <g filter="url(#cardShadow)">
    <rect x="232" y="272" width="560" height="480" rx="36" fill="url(#folderGradient)"/>
  </g>

  <!-- 4. Kart Üzerindeki Arayüz Çizgileri -->
  <!-- macOS Pencere Noktaları -->
  <circle cx="292" cy="332" r="12" fill="#FF5F56"/>
  <circle cx="332" cy="332" r="12" fill="#FFBD2E"/>
  <circle cx="372" cy="332" r="12" fill="#27C93F"/>

  <!-- 3 Kategori Kart Bloğu (Documents, Images, Videos) -->
  <rect x="292" y="380" width="130" height="74" rx="14" fill="#7757E8" fill-opacity="0.12"/>
  <rect x="446" y="380" width="130" height="74" rx="14" fill="#7757E8" fill-opacity="0.12"/>
  <rect x="600" y="380" width="130" height="74" rx="14" fill="#7757E8" fill-opacity="0.12"/>

  <!-- Düzenleme Satırları (Mor & Yeşil Safe Göstergeleri) -->
  <rect x="292" y="484" width="438" height="64" rx="14" fill="#7757E8" fill-opacity="0.08"/>
  <rect x="312" y="504" width="160" height="24" rx="6" fill="#7757E8"/>
  
  <rect x="292" y="568" width="438" height="64" rx="14" fill="#7757E8" fill-opacity="0.08"/>
  <rect x="312" y="588" width="220" height="24" rx="6" fill="#23865B"/>
</svg>
